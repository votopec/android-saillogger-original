<?xml version="1.0" encoding="utf-8"?>


    <ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
<androidx.constraintlayout.widget.ConstraintLayout

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="30dp"
    tools:context=".SettingsDialogFragment">


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/title_settings_text_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textSize="30sp"
        android:padding="20dp"
        android:text="Settings" />


    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Boat: "
        android:id="@+id/boat_no_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title_settings_text_view"
        />
    <TextView
        android:layout_marginStart="20sp"
        android:text="1"
        style="@style/logging_data_textviews"
        app:layout_constraintStart_toEndOf="@id/boat_no_button"
        app:layout_constraintBottom_toBottomOf="@id/boat_no_button"
        android:id="@+id/boatno_text_view"
        />
    <View
        android:layout_marginStart="20sp"
        android:layout_width="30sp"
        android:layout_height="30sp"
        app:layout_constraintStart_toEndOf="@id/boatno_text_view"
        app:layout_constraintBottom_toBottomOf="@id/boatno_text_view"
        android:id="@+id/boatno_color"
        android:background="@color/black"
        />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/team_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/boat_no_button"
        android:text="Team" />


    <TextView
       style="@style/logging_data_textviews"
        android:id="@+id/team_text_view"
        android:paddingHorizontal="20dp"
        app:layout_constraintStart_toEndOf="@id/team_button"
        app:layout_constraintBottom_toBottomOf="@id/team_button"
        android:text="Team"
        />

    <!--    Frequency-->
    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Log Freq"
        android:id="@+id/frequancy_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/team_button"
        app:layout_constraintRight_toRightOf="parent"
        />
    <TextView
        style="@style/logging_data_textviews"
        android:id="@+id/frequency_text_view"
        android:paddingHorizontal="20dp"
        app:layout_constraintStart_toEndOf="@id/frequancy_button"
        app:layout_constraintBottom_toBottomOf="@id/frequancy_button"
        android:text="1/S"
        />

    <TextView
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:id="@+id/extra_offset_title_text_view"
        android:layout_marginTop="20dp"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/frequancy_button"
        android:text="Extra Offsets:" />
    <Button
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:id="@+id/extra_pitch_button"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/extra_offset_title_text_view"
        android:text="Pitch" />
    <TextView
       style="@style/logging_data_textviews"
        android:id="@+id/extra_pitch_text_view"
        android:paddingHorizontal="20dp"
        app:layout_constraintStart_toEndOf="@id/extra_pitch_button"
        app:layout_constraintBottom_toBottomOf="@id/extra_pitch_button"
        />
    <Button
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:id="@+id/extra_heel_button"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/extra_pitch_button"
        android:text="Heel" />
    <TextView
        style="@style/logging_data_textviews"
        android:id="@+id/extra_heel_text_view"
        android:paddingHorizontal="20dp"
        app:layout_constraintStart_toEndOf="@id/extra_heel_button"
        app:layout_constraintBottom_toBottomOf="@id/extra_heel_button"
        />
    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reset_zeroing"
        android:id="@+id/reset_offsets_button"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/extra_heel_button"
        app:layout_constraintStart_toStartOf="parent"
        />
    <TextView
        style="@style/logging_data_textviews"
        android:id="@+id/heel_offset_text_view"
        android:paddingHorizontal="20dp"
        app:layout_constraintStart_toEndOf="@id/reset_offsets_button"
        app:layout_constraintTop_toTopOf="@id/reset_offsets_button"
        />
    <TextView
        style="@style/logging_data_textviews"
        android:id="@+id/pitch_offset_text_view"
        android:paddingHorizontal="20dp"
        app:layout_constraintStart_toEndOf="@id/reset_offsets_button"
        app:layout_constraintBottom_toBottomOf="@id/reset_offsets_button"
        />



<!--    What to Log-->
  <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="30dp"
      android:text="@string/log_title"
      android:id="@+id/log_title_text_view"
      android:textSize="30sp"
      app:layout_constraintTop_toBottomOf="@id/reset_offsets_button"
      app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.SwitchCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/heel"
        android:checked="true"
        android:id="@+id/log_heel_switch"
        app:layout_constraintTop_toBottomOf="@id/log_title_text_view"
        app:layout_constraintStart_toStartOf="@id/log_title_text_view"/>
    <androidx.appcompat.widget.SwitchCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pitch"
        android:checked="true"

        android:id="@+id/log_pitch_switch"
        app:layout_constraintTop_toBottomOf="@id/log_heel_switch"
        app:layout_constraintStart_toStartOf="@id/log_title_text_view"/>
    <androidx.appcompat.widget.SwitchCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/heading"
        android:checked="false"

        android:id="@+id/log_heading_switch"
        app:layout_constraintTop_toBottomOf="@id/log_pitch_switch"
        app:layout_constraintStart_toStartOf="@id/log_title_text_view"/>

    <androidx.appcompat.widget.SwitchCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/altitude"
        android:checked="false"
        android:id="@+id/log_altitude_switch"
        app:layout_constraintTop_toBottomOf="@id/log_heading_switch"
        app:layout_constraintStart_toStartOf="@id/log_title_text_view"/>


    <androidx.appcompat.widget.SwitchCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Log Cyclops Devices"
        android:checked="false"
        android:id="@+id/log_cyclops_switch"
        app:layout_constraintTop_toBottomOf="@id/log_altitude_switch"
        app:layout_constraintStart_toStartOf="@id/log_title_text_view"/>
    <androidx.appcompat.widget.SwitchCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/magnet"
        android:visibility="gone"
        android:checked="false"
        android:id="@+id/log_magnet_switch"
        app:layout_constraintTop_toBottomOf="@id/log_cyclops_switch"
        app:layout_constraintStart_toStartOf="@id/log_title_text_view"/>
    <!--    Events QR size-->
    <Button
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:id="@+id/qr_size_button"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/log_magnet_switch"
        android:text="Events per QR:" />
    <TextView
        style="@style/logging_data_textviews"
        android:id="@+id/qr_size_text_view"
        android:paddingHorizontal="20dp"
        app:layout_constraintStart_toEndOf="@id/qr_size_button"
        app:layout_constraintBottom_toBottomOf="@id/qr_size_button"
        />
<!--OK and Cancel-->
    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/qr_size_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cancel_settings_button"
        android:text="OK"
        android:id="@+id/ok_settings_button"
        />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/ok_settings_button"
        app:layout_constraintStart_toEndOf="@id/ok_settings_button"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="Cancel"
        android:id="@+id/cancel_settings_button"
        />
 </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
