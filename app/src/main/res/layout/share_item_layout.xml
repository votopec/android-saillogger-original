<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    android:background="@color/app_surface"
    android:padding="@dimen/space_md"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/app_text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="2023-08-13_063000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/file_name_text_view"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/app_text_secondary"
        app:layout_constraintStart_toStartOf="@id/file_name_text_view"
        app:layout_constraintTop_toBottomOf="@id/file_name_text_view"
        android:id="@+id/type_text_view"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1.3 MB"
        android:textColor="@color/app_text_secondary"
        app:layout_constraintStart_toStartOf="@id/file_name_text_view"
        app:layout_constraintTop_toBottomOf="@id/type_text_view"
        android:id="@+id/size_text_view"/>
    <ImageButton
        android:layout_width="70dp"
        android:layout_height="@dimen/button_min_height"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/baseline_share_32"
        android:contentDescription="@string/share_file"
        android:backgroundTint="@color/app_surface_alt"
        app:layout_constraintTop_toBottomOf="@id/file_name_text_view"
        android:id="@+id/send_file_button"/>
    <ImageButton
        android:layout_width="50dp"
        android:layout_height="@dimen/button_min_height"
        android:backgroundTint="@color/app_surface_alt"
        app:layout_constraintEnd_toStartOf="@id/send_file_button"
        android:src="@drawable/baseline_qr_code_32"
        android:contentDescription="@string/show_events_qr"
        app:layout_constraintTop_toTopOf="@id/send_file_button"
        android:id="@+id/show_qr_button"/>
    <ImageButton
        android:layout_width="50dp"
        android:layout_height="@dimen/button_min_height"
        android:backgroundTint="@color/app_surface_alt"
        app:layout_constraintEnd_toStartOf="@id/show_qr_button"
        android:src="@drawable/baseline_content_copy_32"
        android:contentDescription="@string/copy_events"
        app:layout_constraintTop_toTopOf="@id/send_file_button"
        android:id="@+id/events_copy_button"/>



</androidx.constraintlayout.widget.ConstraintLayout>
