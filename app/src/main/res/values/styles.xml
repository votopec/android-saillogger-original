<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ptc_heel_az_textviews">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">30sp</item>
        <item name="android:gravity">end</item>
        <item name="android:paddingEnd">20sp</item>
        <item name="android:textColor">@color/app_text_primary</item>

    </style>



    <style name="ptch_heel_az_titles">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:gravity">start</item>
        <item name="android:paddingStart">20sp</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="top_bottom_text_views">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/app_text_primary</item>

    </style>

    <style name="logging_data_textviews">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingHorizontal">5dp</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="big_colored_letters">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">50sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="logging_data_textviews_values">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">end</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingHorizontal">5dp</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="gps_textviews">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/status_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/status_danger</item>
    </style>

    <style name="SafetyStatusText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/status_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">@dimen/space_md</item>
        <item name="android:paddingVertical">@dimen/space_sm</item>
        <item name="android:textColor">@color/status_danger</item>
    </style>

    <style name="SafetyScreenTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="MetricLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/metric_label_text_size</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/app_text_secondary</item>
    </style>

    <style name="MetricValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/metric_value_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="PrimaryActionButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:paddingHorizontal">@dimen/space_lg</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/app_primary</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>

    <style name="SecondaryActionButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:paddingHorizontal">@dimen/space_lg</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="backgroundTint">@color/app_surface_alt</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>

    <style name="DangerActionButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:paddingHorizontal">@dimen/space_lg</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/status_danger</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>

    <style name="SettingsSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="SettingsHintText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/app_text_secondary</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_sm</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="SettingsLabelText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="SettingsValueText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">end</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="SettingsSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_sm</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="mark_buttons">
        <item name="android:layout_width">100dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:textSize">15sp</item>
    </style>
    <!--       Numeric Keyboarr Buttons-->
    <style name="numeric_keyboard_buttons">
        <item name="android:layout_height">@dimen/numeric_key_height</item>
        <item name="android:layout_width">@dimen/numeric_key_width</item>
        <item name="android:textSize">@dimen/numeric_key_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_margin">@dimen/numeric_key_margin_size</item>
    </style>

</resources>
