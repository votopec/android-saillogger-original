<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nonLoggingFragment">

    <fragment
        android:id="@+id/nonLoggingFragment"
        android:name="com.ibsailing.saillogger.NonLoggingFragment"
        android:label="NonLoggingFragment"
        tools:layout="@layout/fragment_non_logging">
        <action
            android:id="@+id/action_nonLoggingFragment_to_shareFragment"
            app:destination="@id/shareFragment"
            />
        <action
            android:id="@+id/action_nonLoggingFragment_to_loggingFragment"
            app:destination="@id/loggingFragment" />
        <action
            android:id="@+id/action_nonLoggingFragment_to_blankFragment"
            app:destination="@id/blankFragment" />
    </fragment>
    <fragment
        android:id="@+id/shareFragment"
        android:name="com.ibsailing.saillogger.ShareFragment"
        android:label="fragment_share"
        tools:layout="@layout/fragment_share" >

    </fragment>

    <fragment
        android:id="@+id/loggingFragment"
        android:name="com.ibsailing.saillogger.LoggingFragment"
        android:label="LoggingFragment"
        tools:layout="@layout/fragment_logging">
        <action
            android:id="@+id/action_loggingFragment_to_nonLoggingFragment"
            app:destination="@id/nonLoggingFragment" />
    </fragment>
    <fragment
        android:id="@+id/blankFragment"
        android:name="com.ibsailing.saillogger.BlankFragment"
        android:label="fragment_blank"
        tools:layout="@layout/fragment_blank" />
</navigation>